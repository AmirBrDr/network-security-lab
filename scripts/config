Host r1
    HostName 10.0.160.130
    User etu
    Port 2222

Host r2
    HostName 10.99.0.2
    User etu
    Port 22
    ProxyJump r1

Host r3
    HostName 10.99.0.3
    User etu
    Port 22
    ProxyJump r1

Host monitoring
    HostName 10.99.0.65
    User etu
    Port 22
    ProxyJump r1

Host management
    HostName 10.99.0.66
    User etu
    Port 22
    ProxyJump r1

    LocalForward 3000 127.0.0.1:3000
    LocalForward 9090 127.0.0.1:9090
    LocalForward 3100 127.0.0.1:3100
    ExitOnForwardFailure yes

# Phase 5: reverse tunnel so the Management VM can reach Ollama running on
# this Mac. Run from the Mac: ssh -N -F scripts/config management-ollama-tunnel
# Separate from "management" above so it doesn't collide with its LocalForward
# ports when both are open at once.
Host management-ollama-tunnel
    HostName 10.99.0.66
    User etu
    Port 22
    ProxyJump r1

    RemoteForward 11434 127.0.0.1:11434
    ExitOnForwardFailure yes
    ServerAliveInterval 30
    ServerAliveCountMax 3