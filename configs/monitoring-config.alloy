loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "system" {
  forward_to    = [loki.write.lab.receiver]
  relabel_rules = loki.relabel.journal.rules
  labels        = {
    job  = "systemd-journal",
    lab  = "network-security-lab",
    node = "monitoring",
  }
}

loki.write "lab" {
  endpoint {
    url = "http://10.99.0.66:3100/loki/api/v1/push"
  }
}

local.file_match "suricata_eve" {
  path_targets = [
    {
      __path__ = "/var/log/suricata/eve.json",
      job      = "suricata-eve",
      lab      = "network-security-lab",
      node     = "monitoring",
    },
  ]
}

loki.source.file "suricata_eve" {
  targets    = local.file_match.suricata_eve.targets
  forward_to = [loki.process.suricata_eve.receiver]
}

loki.process "suricata_eve" {
  stage.json {
    expressions = {
      event_type = "event_type",
    }
  }

  stage.labels {
    values = {
      event_type = "",
    }
  }

  forward_to = [loki.write.lab.receiver]
}


